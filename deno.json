{
  "name": "@tidekeepers/server",
  "version": "0.1.0",
  "exports": "./main.ts",
  "tasks": {
    "start": "deno run -A --unstable-kv --unstable-cron main.ts",
    "dev": "deno run -A --watch --unstable-kv --unstable-cron main.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check --unstable-kv --unstable-cron main.ts",
    "test": "deno test -A --unstable-kv --unstable-cron",
    "content:publish": "deno run -A --unstable-kv src/cli/content_publish.ts",
    "content:cutover": "deno run -A --unstable-kv src/cli/content_cutover.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "hono": "npm:hono@^4.6.14",
    "hash-wasm": "npm:hash-wasm@^4.12.0"
  },
  "fmt": {
    "include": ["main.ts", "src/", "tests/"]
  },
  "lint": {
    "include": ["main.ts", "src/", "tests/"],
    "rules": {
      "tags": ["recommended"],
      "exclude": ["require-await"]
    }
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true
  }
}
