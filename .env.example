APP_ENV=local
HTTP_ADDR=:8080

# Cookie sessions
SESSION_COOKIE_NAME=tidekeepers_session
# Set false only for explicit local HTTP development.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=
SESSION_TTL_MS=2592000000

# Deterministic guest identity (required in staging/production)
PLAYER_ID_SECRET=replace-with-a-long-random-secret
# Only enable when the deployment proxy overwrites this header.
TRUSTED_PROXY=false
TRUSTED_PROXY_HEADER=x-forwarded-for

# Game clock and immutable content release
GAME_TIMEZONE=UTC
LOCK_TIME=23:55
CONTENT_VERSION=4

# Request limits and observability
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info
SERVICE_VERSION=development

# Market provider configuration
MARKET_PROVIDER=static
MARKET_API_KEY=
