APP_ENV=local
HTTP_ADDR=:8080
DATABASE_URL=postgres://tidekeepers:tidekeepers@localhost:5432/tidekeepers?sslmode=disable
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
DATABASE_ACQUIRE_TIMEOUT=2s
DATABASE_QUERY_TIMEOUT=3s
DATABASE_HEALTH_TIMEOUT=1s

SESSION_COOKIE_NAME=tidekeepers_session
# Set false only for explicit local HTTP development.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=

RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=1m
TRUSTED_PROXY_CIDRS=

HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_MAX_HEADER_BYTES=1048576

LOG_LEVEL=info
SERVICE_VERSION=development
TEST_SUPPORT_ENABLED=false
